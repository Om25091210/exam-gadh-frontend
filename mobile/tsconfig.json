{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@/*": ["./src/*"],
      "@eg/api": ["../packages/api/src/index.ts"],
      "@eg/i18n": ["../packages/i18n/src/index.ts"],
