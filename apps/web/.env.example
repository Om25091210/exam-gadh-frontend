# Server-side only: where the Next.js server proxies /v1 and where the session routes call.
API_URL=http://localhost:4000
# Public: Google OAuth web client id (docs/BLOCKERS.md BL-3). Without it the login page says sign-in is not set up.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
# Public: Razorpay key id for checkout (BL-2)
NEXT_PUBLIC_RAZORPAY_KEY_ID=
